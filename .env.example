# Copiá este archivo como .env y completalo cuando la cátedra entregue la API.
# Las variables VITE_* quedan incluidas en el código que baja el navegador:
# no pongas claves secretas que no puedan ser públicas.

# URL base de la API central, p. ej. https://api.catedra.example/v1
VITE_CENTRAL_API_URL=

# Solo si la API pide una clave. Se envía en el header indicado.
VITE_CENTRAL_API_KEY=
VITE_CENTRAL_API_KEY_HEADER=Authorization
